# Copy to .env.local for local development (never commit .env.local), and set the same variable in
# Vercel: Project → Settings → Environment Variables.

# Web3Forms access key for the contact form (free, emailed to you at https://web3forms.com).
# It is public by design (it ends up in the browser bundle) and can only send to your inbox;
# restrict it to your domain in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_KEY=
